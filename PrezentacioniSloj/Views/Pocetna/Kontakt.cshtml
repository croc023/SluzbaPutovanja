@{
    ViewBag.Title = "Kontakt";
}

<div class="container my-4">
    <h2 class="fw-bold mb-3">Kontakt i podrška</h2>
    <p class="text-muted mb-4">Za pitanja u vezi sa podnošenjem zahteva ili tehničku podršku aplikacije, kontaktirajte administrativni tim.</p>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm bg-light h-100">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Korisnička služba</h5>
                    <p class="mb-2"><strong>Adresa:</strong> Sektor za opšte i pravne poslove</p>
                    <p class="mb-2"><strong>Telefon:</strong> +381 23 555 000</p>
                    <p class="mb-2"><strong>E-mail:</strong> podrska@sluzbenaputovanja.rs</p>
                    <p class="mb-0"><strong>Radno vreme:</strong> Ponedeljak – Petak (08:00 – 16:00h)</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm bg-light h-100">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">IT Podrška</h5>
                    <p class="card-text">Ukoliko uočite nepravilnosti u radu sistema ili vam je potrebna dodela prava pristupa, pošaljite upit IT timu.</p>
                    <a href="mailto:it-podrska@sluzbenaputovanja.rs" class="btn btn-outline-primary mt-2">Pošalji e-mail IT službi</a>
                </div>
            </div>
        </div>
    </div>
</div>