@model PrezentacioniSloj.ViewModels.KreiranjeZahtevaViewModel

@{
    ViewBag.Title = "Izmeni zahtev";
}

<h2>Izmeni zahtev za službeno putovanje</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.BrojZahteva)

    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(m => m.ZaposleniID, "Zaposleni", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(m => m.ZaposleniID, Model.ZaposleniLista, "-- Izaberite zaposlenog --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ZaposleniID, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Destinacija, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.Destinacija, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Destinacija, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.PoslovniRazlog, "Poslovni razlog", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextAreaFor(m => m.PoslovniRazlog, new { @class = "form-control", rows = 4 })
                @Html.ValidationMessageFor(m => m.PoslovniRazlog, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.UkupanProcenjeniTrosak, "Ukupan trošak", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.UkupanProcenjeniTrosak, new { @class = "form-control", type = "number", step = "0.01" })
                @Html.ValidationMessageFor(m => m.UkupanProcenjeniTrosak, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Sačuvaj izmene" class="btn btn-primary" />
                @Html.ActionLink("Nazad na listu", "Indeks", null, new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}