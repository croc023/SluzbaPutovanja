@model IEnumerable<PrezentacioniSloj.ViewModels.ZahtevZaPutovanjeViewModel>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Izveštaj - Spisak zahteva za službena putovanja</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 20px;
            background-color: #fff;
        }

        .header-print {
            text-align: center;
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            body {
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <div class="mb-3 no-print">
        <button onclick="window.print()" class="btn btn-primary">Štampaj izveštaj</button>
        <button onclick="window.close()" class="btn btn-secondary">Zatvori</button>
    </div>

    <div class="header-print">
        <h2>SPISAK ZAHTEVA ZA SLUŽBENA PUTOVANJA</h2>
        <p class="text-muted mb-0">Datum generisanja izveštaja: @DateTime.Now.ToString("dd.MM.yyyy. HH:mm")</p>
        @if (!string.IsNullOrEmpty(ViewBag.StatusFilter as string) || !string.IsNullOrEmpty(ViewBag.PretragaFilter as string))
        {
            <small>Filtrirano po — Status: <b>@(ViewBag.StatusFilter ?? "Svi")</b> | Pretraga: <b>@(ViewBag.PretragaFilter ?? "Nema")</b></small>
        }
    </div>

    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>R. br.</th>
                <th>Oznaka</th>
                <th>Zaposleni</th>
                <th>Destinacija</th>
                <th>Datum podnošenja</th>
                <th>Status</th>
                <th class="text-end">Ukupni troškovi</th>
            </tr>
        </thead>
        <tbody>
            @{
                int rb = 1;
                decimal ukupnoSve = 0;
            }
            @foreach (var item in Model)
            {
                ukupnoSve += item.UkupanProcenjeniTrosak;
                <tr>
                    <td>@(rb++)</td>
                    <td>@item.OznakaZahteva</td>
                    <td>@item.ImePrezimeZaposlenog</td>
                    <td>@item.Destinacija</td>
                    <td>@item.DatumPodnosenja.ToString("dd.MM.yyyy.")</td>
                    <td>@item.Status</td>
                    <td class="text-end">@item.UkupanProcenjeniTrosak.ToString("N2") RSD</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold table-secondary">
                <td colspan="6" class="text-end">UKUPNO PROSLEDJENI TROŠKOVI:</td>
                <td class="text-end">@ukupnoSve.ToString("N2") RSD</td>
            </tr>
        </tfoot>
    </table>
</body>
</html>