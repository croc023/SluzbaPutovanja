@model PrezentacioniSloj.ViewModels.ZahtevZaPutovanjeViewModel

@{
    ViewBag.Title = "Brisanje zahteva";
}

<h2>Brisanje zahteva</h2>

<h3>Da li ste sigurni da želite da obrišete ovaj zahtev?</h3>
<div>
    <h4>Detalji zahteva</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Oznaka zahteva:</dt>
        <dd>@Html.DisplayFor(model => model.OznakaZahteva)</dd>

        <dt>Zaposleni:</dt>
        <dd>@Html.DisplayFor(model => model.ImePrezimeZaposlenog)</dd>

        <dt>Destinacija:</dt>
        <dd>@Html.DisplayFor(model => model.Destinacija)</dd>

        <dt>Status:</dt>
        <dd>@Html.DisplayFor(model => model.Status)</dd>

        <dt>Ukupan trošak:</dt>
        <dd>@Html.DisplayFor(model => model.UkupanProcenjeniTrosak)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Obriši" class="btn btn-danger" />
            @Html.ActionLink("Nazad na listu", "Indeks", null, new { @class = "btn btn-default" })
        </div>
    }
</div>