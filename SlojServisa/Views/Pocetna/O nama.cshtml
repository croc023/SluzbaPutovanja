@{
    ViewBag.Title = "O nama";
}

<div class="my-4">
    <div class="p-4 mb-4 bg-light rounded-3 border">
        <h1 class="display-6 fw-bold">O aplikaciji</h1>
        <p class="lead">Sistem za evidenciju i upravljanje službenim putovanjima omogućava efikasnu izradu, praćenje i štampu zahteva za poslovna putovanja zaposlenih.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm bg-light">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Glavne funkcionalnosti</h5>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">Podnošenje i obrada novih zahteva</li>
                        <li class="mb-2">Pretraga i filtriranje po statusu i destinaciji</li>
                        <li class="mb-2">Zbirna štampa filtriranih spiskova</li>
                        <li class="mb-2">Master-Detail štampa pojedinačnih dokumenata</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm bg-light">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Tehnološka osnova</h5>
                    <p class="card-text">Aplikacija je realizovana kao višelojni sistem sa odvojenim prezentacionim slojem, poslovnom logikom i slojem podataka (ADO.NET / MS SQL Server), uz primenu ASP.NET MVC okvira.</p>
                </div>
            </div>
        </div>
    </div>
</div>